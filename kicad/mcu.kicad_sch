	(text "BUTTON can trigger bootloader\nif pulled high before reset.\nDuration of high input on BOOT0:\n\ntau = R35 * C43\nV(t) = Vmax * (1-exp(-t/tau))\n--> t = -tau * ln(1-V/Vmax)\n\nV > 0.7 * VDD = 2.31V necessary\n--> t = 12 ms"
		(exclude_from_sim no)
		(at 241.3 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "693f60f1-dd2b-4c9b-986e-9ab3895dd6c3")
	)
